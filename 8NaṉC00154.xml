      <lg xml:id="8NaṉC00154">
<l>yāṟṟunīr moḻimāṟṟu niraṉiṟai viṟpūṇ</l>
<l>tāppicai yaḷaimaṟi pāppuk koṇṭukūṭ</l>
<l>ṭaṭimaṟi māṟṟeṉap poruḷkō ḷeṭṭē</l>
      </lg>
      <lg xml:lang="en">
<!--put your translation here-->
